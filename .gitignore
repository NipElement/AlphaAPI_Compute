# Build outputs and caches.
node_modules/
__pycache__/
*.pyc

# Build output. Every `make web` regenerates all of dist with new content-hashed
# filenames, so committing it means a full 1.9 MB churn per build for bytes that
# are reproducible from web/src. `make code` already fails loudly with
# "web/dist missing — run 'make web' first" if it is absent.
web/dist/

# TypeScript incremental caches (vue-tsc -b side effects, not sources).
*.tsbuildinfo

# Local run bookkeeping.
.run_id

# Test-run artifacts. evidence/RUN-*/ is OUTPUT, not source: it is written by
# scripts/ and tests/, read by no framework code, rewritten wholesale on every
# `make test`, and carries host-specific data (AWS ids, IPs, disk state). It is
# the audit record for a run on ONE machine — archive it out-of-band if a run
# needs to be preserved; do not carry it in the code repo.
# The WAIVER below it IS tracked: that is a signed decision document, not output.
evidence/RUN-*/

# Editor / OS noise
.DS_Store
*.swp

# guard.sh baseline: fingerprints THIS machine, not the repo
.guard/
