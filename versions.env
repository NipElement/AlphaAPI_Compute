# ============================================================================
# ARISE B300 Prelab — single version entry point
# Baseline: ARISE-B300-PRELAB-DEPLOY-TEST-001 v1.0 (2026-08-10), plan §4.1
#
# RULES (plan §4.2):
#   - Every binary / image / chart is pinned. Images pin by DIGEST, never :latest.
#   - This file is the ONLY place versions are declared.
#   - scripts/preflight.sh emits evidence/<run_id>/deploy/versions-<run_id>.txt
#     recording what was ACTUALLY installed, for diff against this file.
#   - Checksums are NOT hardcoded here. They are fetched from the official
#     checksum endpoint at install time and recorded into evidence. Hand-copied
#     hashes are unverifiable and therefore forbidden.
# ============================================================================

# ---- Host / lab profile -----------------------------------------------------
LAB_PROFILE=STANDARD              # MINIMAL | STANDARD | FULL  (plan §2.1)
CLUSTER_NAME=b300-prelab
DOCUMENT_ID=ARISE-B300-PRELAB-DEPLOY-TEST-001
DOCUMENT_VERSION=1.0

# ---- Toolchain (plan §4.1) --------------------------------------------------
DOCKER_ENGINE_VERSION=29.6.1      # apt full package version; installed by operator (sudo)
KIND_VERSION=v0.32.0
KUBECTL_VERSION=v1.36.2
KUBE_VERSION=v1.36.2               # kubeadm/kubelet/kubectl on the DGX fleet (node-bootstrap.sh 4c; kubeadm-cluster-config kubernetesVersion)
HELM_VERSION=v3.21.3

# kind node image MUST be pinned by digest, not tag (plan §4.1)
KIND_NODE_IMAGE=kindest/node:v1.36.1@sha256:3489c7674813ba5d8b1a9977baea8a6e553784dab7b84759d1014dbd78f7ebd5

# ---- Platform components ----------------------------------------------------
VOLCANO_VERSION=v1.15.1
INGRESS_NGINX_VERSION=v1.13.2      # platform/overlays/dgx/edge/ingress-nginx.yaml controller digest (re-resolve before cutover)
CERT_MANAGER_VERSION=v1.17.1      # helm chart (infra/dgx/operators/cert-manager-values.yaml, runbooks/day0-cutover.md)
CALICO_VERSION=v3.29.3            # DGX CNI, vendored at platform/vendor/calico-v3.29.3.yaml (images digest-pinned)
CALICO_MANIFEST_SHA256=36163effdfdc785415b937f018e3e324cd8422867d43610c366c8b5c8f5539b1
# The dgx install uses platform/vendor/volcano-v1.15.1.yaml — the upstream
# installer for exactly this version with its three images rewritten to
# digests (2026-08-27). The lab keeps installing from the upstream URL so the
# two copies stay comparable on every rehearsal. dgx-render-check asserts the
# vendored file is digest-pinned.

# ---- Reference only: NOT installed in Phase A (plan §1.3, §4.1) -------------
# CPU lab has no GPU/NVLink/IB. These are recorded so the DGX overlay inherits
# the same lock, and are never applied by the lab overlay.
GPU_OPERATOR_VERSION_REFERENCE=v26.3.3
NETWORK_OPERATOR_VERSION_REFERENCE=v26.4.0

# ---- VAST adapter -----------------------------------------------------------
VAST_ADAPTER=mock-v1              # production adapter is permanently disabled in Phase A
VAST_PRODUCTION_ADAPTER_ENABLED=false

# ---- Networking (confirmed non-overlapping by preflight, plan §6.1) ---------
POD_CIDR=10.244.0.0/16
SERVICE_CIDR=10.96.0.0/12
API_SERVER_ADDRESS=127.0.0.1

# ---- Simulated resources (plan §8.2) ---------------------------------------
FAKE_GPU_RESOURCE=arise.dev/fake-gpu
FAKE_GPU_PER_NODE=8
FAKE_GPU_TOTAL=32

# ---- Install locations (waiver-mode: user-local, no system paths) ----------
# Plan §5.1 nominates /opt/arise/b300-prelab. Under the 2026-08-11 waiver the
# repo lives in the user project tree and binaries in ~/.local/bin so that NO
# system path or existing asset on this shared host is modified.
TOOL_BIN_DIR=/home/ubuntu/.local/bin

# ---- Version drift observed at install time (DEP-01) ------------------------
# 2026-08-11: dl.k8s.io stable-1.36.txt resolved to v1.36.3 (the patch the plan
# anticipated for 2026-08-11). Lock deliberately HELD at v1.36.2 per plan §4.1
# "本方案不在实施中自动追逐 latest". Upgrade requires the §4.2 branch workflow.
K8S_STABLE_OBSERVED_20260811=v1.36.3

# ---- fake-gpu device plugin build (custom-built, LAB delivery) --------------
# (One of two custom-built images since 2026-08-26 — the other is arise/web,
#  the dgx SPA content image; see 'DGX delivery images' below.)
# Go builder resolved 2026-08-16 from registry-1.docker.io, pinned by digest.
# Built by `make plugin` -> arise/fake-gpu-plugin:lab, delivered to nodes via
# `kind load docker-image` (no lab registry -> imagePullPolicy: Never; the
# image ID is recorded in the build evidence as the lab-grade digest pin).
GO_BUILDER_IMAGE=golang:1.23-bookworm@sha256:167053a2bb901972bf2c1611f8f52c44d5fe7e762e5cab213708d82c421614db
FAKE_GPU_PLUGIN_IMAGE=arise/fake-gpu-plugin:lab

# ---- Runtime base image (stdlib-only Python components) ---------------------
# Resolved 2026-08-11 from registry-1.docker.io. Pinned by digest per §4.2
# "镜像优先锁定 digest". No custom image is built: component code is mounted
# from ConfigMaps generated by kustomize, so the supply chain is this one
# upstream image plus reviewable Python in Git.
PYTHON_BASE_IMAGE=python:3.12-slim@sha256:229a2c5bfa27522db7815ea81f9bed70af17ccb9de9fc7ad142b1877b5830d36

# ---- DGX delivery images (WS1) ----------------------------------------------
# The built SPA as a registry-delivered content image (services/web/Dockerfile,
# `make web-image`) — replaces the lab's docker-cp/hostPath delivery on dgx.
# Its base (also the storage helper pod) and the day-0 NVMe provisioner are
# pinned by digest, resolved 2026-08-26 from registry-1.docker.io. At Day-0
# the arise/web tag is replaced by the digest of the image pushed to the
# chosen registry (the tag below is the local build name, not a pin).
ARISE_WEB_IMAGE=arise/web:dgx
# Tenant dev machine with sshd (services/devbox): built by `make devbox-image`,
# kind-loaded for the lab, registry-pushed at Day-0 (portal env DEVBOX_IMAGE).
DEVBOX_IMAGE=arise/devbox:lab
WEB_BASE_IMAGE=busybox:1.37-musl@sha256:fc6dddc4c44b1bfe37f41cae8e67d1693828e8f42a91862816d7953e2c9d3f23
LOCAL_PATH_PROVISIONER_IMAGE=rancher/local-path-provisioner:v0.0.31@sha256:80496fdeb307541007621959aa13aed41d31db9cd2dc4167c19833e0bfa3878c

# ---- DGX ops foundation images (WS6) ----------------------------------------
# etcd: THE SAME image (same digest) kubeadm runs as the etcd static pod — one
# etcd version per cluster, and the backup CronJob's etcdctl/etcdutl can never
# skew from the server. node-exporter + kube-state-metrics feed the
# arise-fleet-health alert rules (dgx overlay only — the lab keeps guard.sh as
# its disk control so no rule ever references an absent series).
# Resolved 2026-08-27 from their registries.
ETCD_IMAGE=registry.k8s.io/etcd:3.6.8-0@sha256:397189418d1a00e500c0605ad18d1baf3b541a1004d768448c367e48071622e5
NODE_EXPORTER_IMAGE=quay.io/prometheus/node-exporter:v1.9.1@sha256:d00a542e409ee618a4edc67da14dd48c5da66726bbd5537ab2af9c1dfc442c8a
KUBE_STATE_METRICS_IMAGE=registry.k8s.io/kube-state-metrics/kube-state-metrics:v2.14.0@sha256:37d841299325c23b56e5951176ce8ef317d537447c0f1b2d2437dddbb1f51165

# ---- Private registry (Day-0 step 5) ----------------------------------------
# The registry that holds the mirrored pinned image set on the head node
# (scripts/registry-mirror.sh fills it; rehearsed against a local instance
# 2026-08-27). Digest resolved from registry-1.docker.io. WHERE it runs (head
# node docker vs an in-cluster Deployment with a PVC) is part of D1.
ACCEPTANCE_IMAGE=nvcr.io/nvidia/pytorch:25.06-py3@sha256:025d9b102b5436d4af8af58f12c6a46b7e5d16f19543b1d2cc4446bf2650b4f1   # HW acceptance (torch+NCCL); infra/dgx/acceptance
REGISTRY_IMAGE=registry:2@sha256:a3d8aaa63ed8681a604f1dea0aa03f100d5895b6a58ace528858a7b332415373

# ---- DGX B300 hardware profile (NVIDIA DGX B300 User Guide, fetched 2026-08-14)
# https://docs.nvidia.com/dgx/dgxb300-user-guide/introduction-to-dgxb300.html
# Per node: 8x B300 Blackwell Ultra (288 GB HBM each, 2.3 TB total),
# 2x Intel Xeon Platinum 6776P (64C/128T each -> 256 threads; core count is the
# CPU SKU's public spec, the user guide itself does not print it),
# 2 TB RAM default (max 4 TB), 8x 3.84 TB E1.S NVMe cache + 2x 1.92 TB M.2 boot,
# 8x ConnectX-8 800Gb/s + 2x dual-port BlueField-3 400Gb/s, NVLink5 x2, 14.5 kW.
# The lab advertises these magnitudes as SIMULATED extended resources so all
# capacity arithmetic runs on real numbers while kind nodes just run sleep pods.
HW_GPU_PER_NODE=8
HW_HBM_GB_PER_GPU=288
HW_SIM_VCPU_GPU_NODE=256
HW_SIM_MEM_GI_GPU_NODE=2048
HW_NVME_CACHE_TB_PER_NODE=30.72
# CPU-pool node SKU is NOT yet decided — placeholder profile, flagged in UI:
HW_SIM_VCPU_CPU_NODE=64
HW_SIM_MEM_GI_CPU_NODE=512
